# -*- mode: rec -*-
#
# Label and tape catalogue for Web Label Editor (GNU recutils format).
#
# Each record is one kind of label or tape for a printer family; every
# printer model in that family whose head is wide enough can use it. Saved
# designs refer to records by Id, so never rename or reuse an Id; add a new
# record instead.
#
# Units are millimetres. Directions are as seen in the editor: the label is
# a horizontal strip, "length" runs left to right along the feed, "width"
# runs across the print head. The left edge comes out of the printer first.
#
#   Family         dymo-lw (LabelWriter 400/450/4XL), brother-pt (P-touch,
#                  TZe tape), brother-ql (QL, DK rolls)
#   Kind           continuous (length comes from the design) or diecut
#   WidthMm        label/tape width across the head
#   LengthMm       label length along the feed (die-cut only)
#   PrintableDots  dots across the head when not simply WidthMm at the
#                  printer's resolution (Brother)
#   PrintableLengthDots  printable dots along a die-cut label (Brother QL)
#   OffsetRightDots, FeedMarginDots  Brother QL placement and feed values
#   Margin*Mm      edges the printer cannot print on (default 0)
#   CornerMm       corner radius drawn in the preview (die-cut only)
#   LabelsAcross   labels side by side in each row ("2 up"); WidthMm is the
#                  whole row and the editor designs one label of it
#   StatusMm       tape width the printer reports in its status (Brother)
#   Source         where the numbers come from
#
# Check the file with:  recfix catalog/media.rec

%rec: Medium
%key: Id
%mandatory: Family Name Kind WidthMm Source
%type: Family enum dymo-lw brother-pt brother-ql
%type: Kind enum continuous diecut
%type: WidthMm,LengthMm,MarginLeftMm,MarginRightMm,MarginTopMm,MarginBottomMm,CornerMm real
%type: PrintableDots,PrintableLengthDots,OffsetRightDots,FeedMarginDots,StatusMm,LabelsAcross int

# ---------------------------------------------------------------------------
# DYMO LabelWriter 400 / 450 / 4XL (300 dpi; 672-dot head, 1248 on the 4XL)
#
# Sizes and margins come from DYMO's lw450.ppd: PaperDimension (W x H points)
# and ImageableArea (llx lly urx ury points), converted at 25.4/72 mm per pt.
# The PPD page is portrait with its top fed first, so:
#   MarginLeftMm = H - ury   (the ~5.8 mm the LabelWriter can't print first)
#   MarginRightMm = lly, MarginTopMm = W - urx, MarginBottomMm = llx

Id: cont-54
Family: dymo-lw
Name: Continuous 54 mm (paper roll)
Kind: continuous
WidthMm: 54.02
MarginLeftMm: 5.76
MarginRightMm: 1.52
MarginTopMm: 1.02
MarginBottomMm: 1.52
Source: lw450.ppd "Continuous, Wide": 153.12 x 792 pt, imageable 4.32 4.32 150.24 775.68

Id: 30252
Family: dymo-lw
Name: 30252 Address 28 × 89 mm
Kind: diecut
WidthMm: 27.86
LengthMm: 88.9
MarginLeftMm: 5.84
MarginRightMm: 1.52
MarginTopMm: 1.02
MarginBottomMm: 1.52
CornerMm: 3
Source: lw450.ppd 30252: 78.96 x 252 pt, imageable 4.32 4.32 76.08 235.44

Id: 99012
Family: dymo-lw
Name: 99012 Large Address 36 × 89 mm
Kind: diecut
WidthMm: 35.73
LengthMm: 88.56
MarginLeftMm: 5.67
MarginRightMm: 1.52
MarginTopMm: 1.02
MarginBottomMm: 1.52
CornerMm: 3
Source: lw450.ppd 99012: 101.28 x 251.04 pt, imageable 4.32 4.32 98.40 234.96

